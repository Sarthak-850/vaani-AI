# ==============================================================================
# VAANI AI — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# Configure these variables in your deployment dashboard (e.g. Vercel / Render).
# NEVER commit real production secret values to GitHub.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Public URL to the deployed backend Express API
VITE_API_URL=https://your-backend-service.onrender.com/api

# Public URL to the deployed backend root for persistent WebSocket / Socket.IO connections
VITE_SOCKET_URL=https://your-backend-service.onrender.com

# Clerk Authentication Publishable Key (for user management & Google OAuth)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Optional client-side Gemini API key (for direct client-side extraction preview fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional Google Maps API key (for GIS map tile rendering)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway / Persistent Server Settings)
# ------------------------------------------------------------------------------
# Server port (default 5000)
PORT=5000

# Server environment ('development' | 'production')
NODE_ENV=production

# Frontend Origin for CORS headers & Socket.IO client authorization
CLIENT_URL=https://your-frontend-domain.vercel.app

# PostgreSQL Database Connection URL (e.g. Supabase, Neon, or Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@your-db-host.supabase.co:5432/postgres

# JWT Secret for signing & verifying authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# JWT Expiration duration (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Google Gemini API Key for server-side clinical entity extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Anthropic API Key (if Claude fallback clinical analysis is enabled)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
